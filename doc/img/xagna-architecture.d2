direction: down

inputs: "xAGNA mod" {
  style.fill: "#1f3b2e"; style.stroke: "#cfe8d8"; style.font-color: "#eafff2"
  omf: "OMF motions" {shape: cylinder; style.fill: "#356049"; style.stroke: "#cfe8d8"; style.font-color: "#eafff2"}
  dltx: "DLTX configs" {shape: page; style.fill: "#356049"; style.stroke: "#cfe8d8"; style.font-color: "#eafff2"}
  scripts: "script layer" {
    style.fill: "#2a4a39"; style.stroke: "#cfe8d8"; style.font-color: "#eafff2"
    core: "xagna_core\ndata" {style.fill: "#356049"; style.stroke: "#cfe8d8"; style.font-color: "#eafff2"}
    ovr: "zzz_xagna_overrides\napplies at game start" {style.fill: "#356049"; style.stroke: "#cfe8d8"; style.font-color: "#eafff2"}
  }
}

vanilla: "vanilla state tables\nload whole, no override" {style.fill: "#2a4a39"; style.stroke: "#cfe8d8"; style.font-color: "#eafff2"}
others: "other animation mods" {style.fill: "#3a3320"; style.stroke: "#e8dcc0"; style.font-color: "#fff6e0"}
engine: "X-Ray engine" {style.fill: "#24344a"; style.stroke: "#cdddf0"; style.font-color: "#eaf3ff"}

inputs.scripts.core -> inputs.scripts.ovr: "data"
inputs.scripts.ovr -> vanilla: "copy_table + field write (additive)"
inputs.omf -> engine: "motions"
vanilla -> engine: "states"
others -> engine: "coexist"
